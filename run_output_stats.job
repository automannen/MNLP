#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=efficiency
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --time=12:00:00
#SBATCH --output=slurm_output_output_stats%A.out
#SBATCH --error=slurm_error_output_stats%A.err

module purge
module load 2025
module load Anaconda3/2025.06-1

conda env update -n mnlp -f environment.yml

cd $HOME/MNLP/

source activate mnlp



python output_stats.py --model nllb-moe-54b --csv results/output_stats_devtest_moe_54b.csv