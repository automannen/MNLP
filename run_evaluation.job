#!/bin/bash

#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=run_evaluation
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=08:00:00
#SBATCH --output=slurm_output_evaluation_%A_%a.out
#SBATCH --error=slurm_error_evaluation_%A_%a.err

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/MNLP/

source activate mnlp

# Compute nodes have no internet: use the models cached by --prepare_only.
export HF_HUB_OFFLINE=1
python run_evaluation.py --checkpoints facebook/nllb-200-distilled-600M --out_csv results/scores_600m.csv 