#!/bin/bash

#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=score_moe54b
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=01:00:00
#SBATCH --output=slurm_output_score_moe54b_%A.out
#SBATCH --error=slurm_error_score_moe54b_%A.err

# Scores only the 54B outputs (chrF++, TER, COMET). No translation happens here.

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/MNLP/

source activate mnlp

# Uses the COMET model cached earlier by run_evaluation.py --prepare_only.
export HF_HUB_OFFLINE=1
python evaluate.py --outputs_dir outputs/nllb-moe-54b --out_csv results/scores_moe54b.csv
